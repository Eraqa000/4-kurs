# Скопируй в backend/.env и заполни. Файл .env НЕ коммитить.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Провайдеры картинок: stub | gemini (платно) | cloudflare (бесплатный лимит).
# Провайдеры описаний: stub | gemini (бесплатный лимит). Ключ — из Google AI Studio (aistudio.google.com).
IMAGE_PROVIDER=stub
DESCRIPTION_PROVIDER=stub
IMAGE_API_KEY=
VISION_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
GEMINI_VISION_MODEL=gemini-3.1-flash-lite
CORS_ORIGINS=["http://localhost:5173"]
RATE_GENERATE_PER_MIN=10
RATE_DESCRIBE_PER_MIN=20
CACHE_TTL_SECONDS=3600
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Локальная БД SQLite (создаётся сама)
DATABASE_PATH=data/audiocanvas.db
# Озвучка для экспорта аудио: stub | gemini (нужен VISION_API_KEY)
TTS_PROVIDER=stub
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Kore
RATE_TTS_PER_MIN=6
